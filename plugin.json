{
  "manifestVersion": 2,
  "name": "cpr-turnstate",
  "displayName": "账号探测",
  "publisher": "milesians",
  "version": "0.1.3",
  "description": "ModelTrace 指纹与测票：主动探测 OpenAI OAuth 账号是否被降智",
  "license": "MIT",
  "author": "Milesians",
  "engines": {
    "codex-proxy-rs": ">=3.34.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    },
    "maintenance": {}
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "probeEnabled": {
        "type": "boolean",
        "title": "发出真实探测",
        "description": "探测会消耗账号的真实额度。关闭时什么也不会发出，手动和自动探测都被拦截",
        "default": false
      },
      "minIntervalMinutes": {
        "type": "integer",
        "title": "自动探测最短间隔（分钟）",
        "description": "同一账号同一方法两次自动探测的最短间隔；手动探测不受限制",
        "minimum": 0,
        "maximum": 10080,
        "default": 30
      },
      "fingerprintSyncHours": {
        "type": "integer",
        "title": "指纹库同步间隔（小时）",
        "description": "从 GitHub 上的 xqy2006/ModelTrace 同步指纹库的间隔，0 表示只用内置的一份",
        "minimum": 0,
        "maximum": 720,
        "default": 6
      },
      "telegramEnabled": {
        "type": "boolean",
        "title": "TG 状态通知",
        "description": "测票连续 3 次确认状态变化后通知；发送失败会重试，不影响探测结果",
        "default": false
      },
      "telegramBotToken": {
        "type": "string",
        "title": "TG Bot Token（敏感字段）",
        "description": "从 BotFather 获取，通过 CPR 独立敏感配置保存，不要填入普通配置",
        "maxLength": 256
      },
      "telegramChatId": {
        "type": "string",
        "title": "TG Chat ID",
        "description": "接收通知的用户、群组 ID 或 @频道名；私聊需先向机器人发送 /start",
        "maxLength": 128,
        "default": ""
      },
      "telegramThreadId": {
        "type": "integer",
        "title": "TG 话题 ID",
        "description": "发送到群组话题时填写，0 表示不指定话题",
        "minimum": 0,
        "maximum": 2147483647,
        "default": 0
      }
    },
    "patternProperties": {
      "^codexVersion$": {
        "type": "string",
        "deprecated": true,
        "description": "仅兼容旧版设置；客户端身份始终读取 CPR，忽略此值"
      }
    },
    "additionalProperties": false
  },
  "secretFields": ["telegramBotToken"],
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "settings",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 4,
      "maximumBytes": 1048576,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "history",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 16777216,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "runs",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 10000,
      "maximumBytes": 16777216,
      "maximumValueBytes": 65536,
      "migratesFrom": []
    }
  ]
}
